# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=estimator
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cost_reaper
POSTGRES_PORT=5432
# Inside Docker the DB host is the compose service name `db`.
DATABASE_URL=postgresql://estimator:change_me@db:5432/cost_reaper?schema=public

# ─── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=8000
# Generate long random values (e.g. `openssl rand -hex 32`). NEVER commit real secrets.
JWT_SECRET=change_me_long_random_at_least_32_chars
JWT_REFRESH_SECRET=change_me_another_long_random_value_32_chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ─── Seed admin (FR-26 / Section 0.1 — created from these, never hardcoded) ───
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me

# ─── Frontend ────────────────────────────────────────────────────────────────
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ─── Cloud pricing (FR-21) ───────────────────────────────────────────────────
# MVP uses the seeded catalog. 730 = average hours/month (hourly → monthly).
CLOUD_HOURS_PER_MONTH=730
# Post-MVP live price sync (FR-21a) — optional, leave blank for MVP:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PRICING_REGION=us-east-1
# AZURE_RETAIL_PRICES_ENDPOINT=https://prices.azure.com/api/retail/prices
# GCP_BILLING_API_KEY=

# ─── FX rates (FR-17) ────────────────────────────────────────────────────────
# Public, no-auth source for the FX-rates "Refresh" button (foreign-per-USD).
FX_RATES_ENDPOINT=https://api.frankfurter.app/latest

# ─── Identity / Single Sign-On (FR-26) ───────────────────────────────────────
# ONE switch picks the identity system:
#   LOCAL  → the app's built-in username/password identity (default)
#   OIDC | SAML | WSFED → delegate sign-in to an external SSO provider
SSO_PROTOCOL=LOCAL                # LOCAL | OIDC | SAML | WSFED
SSO_ENABLED=false                 # master switch; must be true to use an external protocol
SSO_FORCE=false                   # true → hide the built-in password form (SSO only)
SSO_DISPLAY_NAME=Company SSO      # label on the "Sign in with …" button

# OIDC / OpenID Connect (Azure AD, Okta, Google, Auth0, …) — fully supported
SSO_OIDC_ISSUER=                  # e.g. https://login.microsoftonline.com/<tenant>/v2.0
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/callback
SSO_OIDC_SCOPES=openid email profile

# SAML 2.0
SSO_SAML_ENTRY_POINT=             # IdP SSO URL
SSO_SAML_ISSUER=cost-reaper       # our SP entity id
SSO_SAML_CALLBACK_URL=http://localhost:8000/api/v1/auth/sso/callback
SSO_SAML_IDP_CERT=                # IdP signing certificate (PEM or base64 DER)
# SSO_SAML_ALLOW_UNVERIFIED=false # dev only: skip signature check (NOT for prod)

# WS-Federation
SSO_WSFED_LOGIN_URL=              # STS passive sign-in URL
SSO_WSFED_REALM=cost-reaper       # wtrealm
SSO_WSFED_REPLY_URL=http://localhost:8000/api/v1/auth/sso/callback
SSO_WSFED_IDP_CERT=
# SSO_WSFED_ALLOW_UNVERIFIED=false
