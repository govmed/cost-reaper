// cost-reaper data model (CLAUDE.md Section 10). Monetary values are exact
// decimals — never floats (NFR-5). All timestamps UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum RateUnit {
  HOUR
  DAY
}

enum BillingPeriod {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum CloudProvider {
  AWS
  GCP
  AZURE
  SAAS
}

enum CloudPriceUnit {
  HOUR
  MONTH
  GB_MONTH
  GB
  REQUEST
}

enum CloudPriceSource {
  CATALOG_SEED
  AWS_API
  AZURE_API
  GCP_API
}

enum NonLaborType {
  FIXED
  RECURRING
}

enum ChecklistSeverity {
  BLOCKER
  WARNING
  INFO
}

enum ChecklistScope {
  ESTIMATE
  LABOR
  NONLABOR
  CLOUD
  RESOURCE
}

// ─── Identity (FR-1, FR-2, FR-26, NFR-16) ────────────────────────────────────

/// Data-driven roles (FR-30): admins create/modify roles and the permissions each grants.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  displayName String   @map("display_name")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  /// Built-in roles (ADMIN/GM/ESTIMATOR/VIEWER) can't be deleted or recoded.
  isBuiltin   Boolean  @default(false) @map("is_builtin")
  /// Granted permission keys; the ADMIN role holds ['*'] (allow-all).
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  /// Role code (FR-30) validated server-side against the active `roles` table.
  role         String    @default("ESTIMATOR")
  displayName  String?   @map("display_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  rateCards        RateCard[]
  estimates        Estimate[]
  workflowDefs     WorkflowDefinition[]
  transitionEvents WorkflowTransitionEvent[]
  auditEvents      AuditEvent[]
  uploadedDocuments EstimateDocument[]

  @@map("users")
}

/// Supporting documents attached to an estimate (FR-29 doc types). File bytes are
/// stored in-DB (bytea); the document_type is validated against DOCUMENT_TYPE.
model EstimateDocument {
  id           String   @id @default(uuid()) @db.Uuid
  estimateId   String   @map("estimate_id") @db.Uuid
  estimate     Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  fileName     String   @map("file_name")
  /// Reference code from DOCUMENT_TYPE (FR-29); shown by display name in the UI.
  documentType String   @map("document_type")
  description  String?
  contentType  String   @map("content_type")
  sizeBytes    Int      @map("size_bytes")
  content      Bytes
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  @@index([estimateId])
  @@map("estimate_documents")
}

// ─── Reference data: rate cards (FR-3) ───────────────────────────────────────

model RateCard {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  currency    String   @db.Char(3)
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by") @db.Uuid
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles     RateCardRole[]
  estimates Estimate[]

  @@map("rate_cards")
}

model RateCardRole {
  id         String   @id @default(uuid()) @db.Uuid
  rateCardId String   @map("rate_card_id") @db.Uuid
  rateCard   RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)
  roleName   String   @map("role_name")
  unit       RateUnit
  rate       Decimal  @db.Decimal(18, 4)

  laborLines LaborLineItem[]

  @@map("rate_card_roles")
}

// ─── Cloud price catalog (FR-21, NFR-14) ─────────────────────────────────────

model CloudPrice {
  id            String           @id @default(uuid()) @db.Uuid
  provider      CloudProvider
  /// Enterprise category: Compute, Storage, Networking, Database, Containers & Serverless, Analytics, AI & ML, Security & Tools, Management & Monitoring.
  category      String           @default("Compute")
  region        String
  service       String
  skuOrInstance String           @map("sku_or_instance")
  unit          CloudPriceUnit
  unitPrice     Decimal          @map("unit_price") @db.Decimal(18, 6)
  currency      String           @db.Char(3)
  source        CloudPriceSource @default(CATALOG_SEED)
  effectiveDate DateTime         @default(now()) @map("effective_date")
  fetchedAt     DateTime         @default(now()) @map("fetched_at")

  cloudItems CloudComputeLineItem[]

  @@unique([provider, region, service, skuOrInstance, unit])
  @@index([provider, region])
  @@map("cloud_prices")
}

// ─── Estimates (FR-4..FR-8, FR-22, FR-23) ────────────────────────────────────

model Estimate {
  id                    String              @id @default(uuid()) @db.Uuid
  name                  String
  description           String?
  currency              String              @db.Char(3)
  globalUpchargePercent Decimal             @default(0) @map("global_upcharge_percent") @db.Decimal(5, 2)
  contingencyPercent    Decimal             @default(0) @map("contingency_percent") @db.Decimal(5, 2)
  marginPercent         Decimal             @default(0) @map("margin_percent") @db.Decimal(5, 2)
  taxPercent            Decimal             @default(0) @map("tax_percent") @db.Decimal(5, 2)
  rateCardId            String?             @map("rate_card_id") @db.Uuid
  rateCard              RateCard?           @relation(fields: [rateCardId], references: [id])
  ownerId               String              @map("owner_id") @db.Uuid
  owner                 User                @relation(fields: [ownerId], references: [id])
  workflowDefinitionId  String?             @map("workflow_definition_id") @db.Uuid
  workflowDefinition    WorkflowDefinition? @relation(fields: [workflowDefinitionId], references: [id])
  currentStageId        String?             @map("current_stage_id") @db.Uuid
  currentStage          WorkflowStage?      @relation(fields: [currentStageId], references: [id])
  scenarioOfId          String?             @map("scenario_of_id") @db.Uuid
  scenarioOf            Estimate?           @relation("EstimateScenarios", fields: [scenarioOfId], references: [id])
  scenarios             Estimate[]          @relation("EstimateScenarios")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  laborItems        LaborLineItem[]
  nonLaborItems     NonLaborLineItem[]
  cloudItems        CloudComputeLineItem[]
  assumptions       Assumption[]
  comments          Comment[]
  baselines         Baseline[]
  documents         EstimateDocument[]
  transitionEvents  WorkflowTransitionEvent[]
  statementsOfWork  StatementOfWork[]

  @@index([ownerId])
  @@index([scenarioOfId])
  @@map("estimates")
}

model LaborLineItem {
  id                      String        @id @default(uuid()) @db.Uuid
  estimateId              String        @map("estimate_id") @db.Uuid
  estimate                Estimate      @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  rateCardRoleId          String?       @map("rate_card_role_id") @db.Uuid
  rateCardRole            RateCardRole? @relation(fields: [rateCardRoleId], references: [id])
  description             String?
  quantity                Decimal       @default(1) @db.Decimal(18, 4)
  units                   Decimal       @db.Decimal(18, 4)
  unitsOptimistic         Decimal?      @map("units_optimistic") @db.Decimal(18, 4)
  unitsMostLikely         Decimal?      @map("units_most_likely") @db.Decimal(18, 4)
  unitsPessimistic        Decimal?      @map("units_pessimistic") @db.Decimal(18, 4)
  rateSnapshot            Decimal       @map("rate_snapshot") @db.Decimal(18, 4)
  upchargePercentOverride Decimal?      @map("upcharge_percent_override") @db.Decimal(5, 2)
  billingPeriod           BillingPeriod @default(ONE_TIME) @map("billing_period")
  sdlcPhase               String?       @map("sdlc_phase")
  resourceName            String?       @map("resource_name")
  allocationPercent       Decimal       @default(100) @map("allocation_percent") @db.Decimal(5, 2)
  startDate               DateTime?     @map("start_date") @db.Date
  endDate                 DateTime?     @map("end_date") @db.Date
  lineTotal               Decimal       @map("line_total") @db.Decimal(18, 4)

  @@index([estimateId])
  @@map("labor_line_items")
}

model NonLaborLineItem {
  id                      String        @id @default(uuid()) @db.Uuid
  estimateId              String        @map("estimate_id") @db.Uuid
  estimate                Estimate      @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  category                String
  description             String?
  type                    NonLaborType  @default(FIXED)
  amount                  Decimal       @db.Decimal(18, 4)
  upchargePercentOverride Decimal?      @map("upcharge_percent_override") @db.Decimal(5, 2)
  billingPeriod           BillingPeriod @default(ONE_TIME) @map("billing_period")
  periods                 Int           @default(1)
  sdlcPhase               String?       @map("sdlc_phase")
  lineTotal               Decimal       @map("line_total") @db.Decimal(18, 4)

  @@index([estimateId])
  @@map("non_labor_line_items")
}

model CloudComputeLineItem {
  id                      String        @id @default(uuid()) @db.Uuid
  estimateId              String        @map("estimate_id") @db.Uuid
  estimate                Estimate      @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  cloudPriceId            String?       @map("cloud_price_id") @db.Uuid
  cloudPrice              CloudPrice?   @relation(fields: [cloudPriceId], references: [id])
  provider                CloudProvider
  /// Snapshot of the cloud price's enterprise category (Compute / Storage / …).
  category                String?
  region                  String
  service                 String
  skuOrInstance           String        @map("sku_or_instance")
  quantity                Decimal       @default(1) @db.Decimal(18, 4)
  usageHoursPerMonth      Decimal       @default(730) @map("usage_hours_per_month") @db.Decimal(18, 4)
  unitPriceSnapshot       Decimal       @map("unit_price_snapshot") @db.Decimal(18, 6)
  upchargePercentOverride Decimal?      @map("upcharge_percent_override") @db.Decimal(5, 2)
  billingPeriod           BillingPeriod @default(MONTHLY) @map("billing_period")
  sdlcPhase               String?       @map("sdlc_phase")
  lineTotal               Decimal       @map("line_total") @db.Decimal(18, 4)

  @@index([estimateId])
  @@map("cloud_compute_line_items")
}

model Assumption {
  id         String   @id @default(uuid()) @db.Uuid
  estimateId String   @map("estimate_id") @db.Uuid
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  text       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([estimateId])
  @@map("assumptions")
}

model Comment {
  id          String   @id @default(uuid()) @db.Uuid
  estimateId  String   @map("estimate_id") @db.Uuid
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  authorId    String   @map("author_id") @db.Uuid
  authorEmail String   @map("author_email")
  text        String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([estimateId])
  @@map("comments")
}

model FxRate {
  id             String   @id @default(uuid()) @db.Uuid
  currency       String   @unique @db.Char(3)
  /// Base-currency (USD) units per 1 unit of currency. USD = 1.
  rateToBase     Decimal  @map("rate_to_base") @db.Decimal(18, 6)
  updatedByEmail String?  @map("updated_by_email")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("fx_rates")
}

model Baseline {
  id             String   @id @default(uuid()) @db.Uuid
  estimateId     String   @map("estimate_id") @db.Uuid
  estimate       Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  label          String
  grandTotal     Decimal  @map("grand_total") @db.Decimal(18, 4)
  clientPrice    Decimal  @map("client_price") @db.Decimal(18, 4)
  oneTimeTotal   Decimal  @map("one_time_total") @db.Decimal(18, 4)
  monthlyTotal   Decimal  @map("monthly_total") @db.Decimal(18, 4)
  yearlyTotal    Decimal  @map("yearly_total") @db.Decimal(18, 4)
  snapshotJson   Json     @map("snapshot_json")
  createdByEmail String   @map("created_by_email")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([estimateId])
  @@map("baselines")
}

// An editable, official Statement of Work composed from an estimate; the user
// edits the sections, then prints it to an official/legal PDF. Issuing locks it
// and snapshots the pricing so the document is immutable thereafter (BR-3, BR-7).
model StatementOfWork {
  id                 String    @id @default(uuid()) @db.Uuid
  estimateId         String    @map("estimate_id") @db.Uuid
  estimate           Estimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  /// System-assigned document number (e.g. SOW-A1B2C3).
  number             String    @unique
  title              String
  status             String    @default("DRAFT")
  clientName         String    @default("") @map("client_name")
  providerName       String    @default("") @map("provider_name")
  // Narrative sections (BR-7) — composed from the SOW template; tailored before issue.
  executiveSummary          String    @default("") @map("executive_summary")
  customerUnderstanding     String    @default("") @map("customer_understanding")
  overview                  String    @default("")
  scope                     String    @default("")
  outOfScope                String    @default("") @map("out_of_scope")
  solutionOverview          String    @default("") @map("solution_overview")
  deliverables              String    @default("")
  timeline                  String    @default("")
  paymentTerms              String    @default("") @map("payment_terms")
  governanceModel           String    @default("") @map("governance_model")
  rolesResponsibilities     String    @default("") @map("roles_responsibilities")
  nonFunctionalRequirements String    @default("") @map("non_functional_requirements")
  testingStrategy           String    @default("") @map("testing_strategy")
  maintenanceSupport        String    @default("") @map("maintenance_support")
  assumptions               String    @default("")
  risksMitigation           String    @default("") @map("risks_mitigation")
  acceptanceCriteria        String    @default("") @map("acceptance_criteria")
  changeControl             String    @default("") @map("change_control")
  termsAndConditions        String    @default("") @map("terms_and_conditions")
  effectiveDate      DateTime? @map("effective_date")
  issuedAt           DateTime? @map("issued_at")
  totalsSnapshot     Json?     @map("totals_snapshot")
  currencySnapshot   String?   @map("currency_snapshot")
  preparedByEmail    String?   @map("prepared_by_email")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([estimateId])
  @@map("statements_of_work")
}

// ─── Governance: workflow (FR-24) + checklist (FR-25) ────────────────────────

model WorkflowDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  /// System-assigned stable key (e.g. WF-A1B2C3); the user-facing label is `name`.
  key         String   @unique
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by") @db.Uuid
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stages      WorkflowStage[]
  transitions WorkflowTransition[]
  estimates   Estimate[]

  @@map("workflow_definitions")
}

model WorkflowStage {
  id                   String             @id @default(uuid()) @db.Uuid
  workflowDefinitionId String             @map("workflow_definition_id") @db.Uuid
  workflowDefinition   WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  key                  String
  label                String
  sortOrder            Int                @map("sort_order")
  isInitial            Boolean            @default(false) @map("is_initial")
  isTerminal           Boolean            @default(false) @map("is_terminal")

  fromTransitions WorkflowTransition[]      @relation("FromStage")
  toTransitions   WorkflowTransition[]      @relation("ToStage")
  estimatesHere   Estimate[]
  eventsFrom      WorkflowTransitionEvent[] @relation("EventFrom")
  eventsTo        WorkflowTransitionEvent[] @relation("EventTo")

  @@unique([workflowDefinitionId, key])
  @@map("workflow_stages")
}

model WorkflowTransition {
  id                    String             @id @default(uuid()) @db.Uuid
  workflowDefinitionId  String             @map("workflow_definition_id") @db.Uuid
  workflowDefinition    WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  /// System-assigned stable key (e.g. TR-A1B2C3); `label` is the user-facing button text.
  key                   String             @unique
  description           String?
  fromStageId           String             @map("from_stage_id") @db.Uuid
  fromStage             WorkflowStage      @relation("FromStage", fields: [fromStageId], references: [id], onDelete: Cascade)
  toStageId             String             @map("to_stage_id") @db.Uuid
  toStage               WorkflowStage      @relation("ToStage", fields: [toStageId], references: [id], onDelete: Cascade)
  allowedRole           String             @map("allowed_role")
  label                 String
  requiresChecklistPass Boolean            @default(true) @map("requires_checklist_pass")

  @@map("workflow_transitions")
}

model WorkflowTransitionEvent {
  id          String         @id @default(uuid()) @db.Uuid
  estimateId  String         @map("estimate_id") @db.Uuid
  estimate    Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  fromStageId String?        @map("from_stage_id") @db.Uuid
  fromStage   WorkflowStage? @relation("EventFrom", fields: [fromStageId], references: [id])
  toStageId   String         @map("to_stage_id") @db.Uuid
  toStage     WorkflowStage  @relation("EventTo", fields: [toStageId], references: [id])
  actorId     String         @map("actor_id") @db.Uuid
  actor       User           @relation(fields: [actorId], references: [id])
  note        String?
  occurredAt  DateTime       @default(now()) @map("occurred_at")

  @@index([estimateId])
  @@map("workflow_transition_events")
}

// A named, system-keyed collection of checklist rules (FR-25). The default set
// drives evaluation for every estimate; admins can curate alternates.
model ChecklistRuleSet {
  id          String   @id @default(uuid()) @db.Uuid
  /// System-assigned stable key (e.g. RS-A1B2C3); the user-facing label is `name`.
  key         String   @unique
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rules ChecklistRule[]

  @@map("checklist_rule_sets")
}

model ChecklistRule {
  id          String            @id @default(uuid()) @db.Uuid
  key         String            @unique
  description String
  severity    ChecklistSeverity @default(BLOCKER)
  scope       ChecklistScope    @default(ESTIMATE)
  isActive    Boolean           @default(true) @map("is_active")
  isBuiltin   Boolean           @default(true) @map("is_builtin")
  configJson  Json?             @map("config_json")
  ruleSetId   String            @map("rule_set_id") @db.Uuid
  ruleSet     ChecklistRuleSet  @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)

  @@index([ruleSetId])
  @@map("checklist_rules")
}

// ─── Audit trail (FR-11) ─────────────────────────────────────────────────────

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id])
  ipAddress  String?  @map("ip_address")
  location   String?
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([entityType, entityId])
  @@map("audit_events")
}

// ─── Reference data platform (FR-29, NFR-17) ─────────────────────────────────
// Generic, DB-driven reference/lookup values — no hard-coded enums in logic.

model ReferenceType {
  id           String           @id @default(uuid()) @db.Uuid
  code         String           @unique
  displayName  String           @map("display_name")
  description  String?
  displayOrder Int              @default(0) @map("display_order")
  isActive     Boolean          @default(true) @map("is_active")
  createdById  String?          @map("created_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedById  String?          @map("updated_by") @db.Uuid
  updatedAt    DateTime         @updatedAt @map("updated_at")
  values       ReferenceValue[]

  @@map("reference_types")
}

model ReferenceValue {
  id              String           @id @default(uuid()) @db.Uuid
  referenceTypeId String           @map("reference_type_id") @db.Uuid
  referenceType   ReferenceType    @relation(fields: [referenceTypeId], references: [id], onDelete: Cascade)
  parentId        String?          @map("parent_id") @db.Uuid
  parent          ReferenceValue?  @relation("ReferenceValueChildren", fields: [parentId], references: [id])
  children        ReferenceValue[] @relation("ReferenceValueChildren")
  code            String
  displayName     String           @map("display_name")
  description     String?
  displayOrder    Int              @default(0) @map("display_order")
  isActive        Boolean          @default(true) @map("is_active")
  isBuiltin       Boolean          @default(false) @map("is_builtin")
  metadataJson    Json?            @map("metadata_json")
  createdById     String?          @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedById     String?          @map("updated_by") @db.Uuid
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([referenceTypeId, code])
  @@index([referenceTypeId])
  @@index([parentId])
  @@map("reference_values")
}
