{
  "name": "cost-reaper",
  "version": "1.0.1",
  "private": true,
  "description": "Technology Project Cost Estimator — pnpm + Turborepo monorepo (web + API + shared packages).",
  "repository": {
    "type": "git",
    "url": "https://github.com/govmed/cost-reaper.git"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,json,md,yml,yaml}\"",
    "prisma:generate": "pnpm --filter @cost-reaper/api prisma:generate",
    "prisma:migrate": "pnpm --filter @cost-reaper/api prisma:migrate:deploy",
    "seed": "pnpm --filter @cost-reaper/api seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  }
}
