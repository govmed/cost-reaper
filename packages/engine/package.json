{
  "name": "@cost-reaper/engine",
  "version": "1.0.1",
  "private": true,
  "description": "Pure estimation engine (no I/O): line totals, upcharge, contingency, monthly/yearly rollups.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@cost-reaper/types": "workspace:*",
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
